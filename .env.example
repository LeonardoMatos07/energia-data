# Copie para .env e ajuste. Todo valor tem padrão no docker-compose.yml.

# Linux: rode `id -u` e coloque o resultado aqui.
AIRFLOW_UID=50000

AIRFLOW_ADMIN_USERNAME=airflow
AIRFLOW_ADMIN_PASSWORD=airflow
AIRFLOW_JWT_SECRET=local-dev-jwt-secret-change-me

# Pipeline de rede: primeiro mês processado pelo agendador.
PIPELINE_START_DATE=2025-01-01

# Curtailment: meses reprocessados a cada execução (o ONS revisa dados publicados)
# e desvio máximo entre o rateio por usina e a GNRa oficial do ONS.
REPROCESS_MONTHS=3
RECONCILIATION_TOLERANCE=0.01

LAKE_BUCKET=energy-lake
LAKE_ACCESS_KEY=lakeadmin
LAKE_SECRET_KEY=lakesecret

WAREHOUSE_USER=warehouse
WAREHOUSE_PASSWORD=warehouse
WAREHOUSE_DB=warehouse

# Revalidação do portal via energia-api. Localmente a API roda sem autenticação.
API_URL=http://host.docker.internal:8000
# Produção: app client de máquina do Cognito (client credentials).
COGNITO_TOKEN_URL=
DATA_CLIENT_ID=
DATA_CLIENT_SECRET=
